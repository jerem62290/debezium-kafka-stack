[Unit]
Description=Prometheus Blackbox Exporter {{ blackbox_exporter_version }}
After=network-online.target
Wants=network-online.target

[Service]
User=blackbox_exporter
Group=blackbox_exporter
ExecStart={{ blackbox_exporter_install_dir }}/blackbox_exporter --config.file={{ blackbox_exporter_config_dir }}/blackbox.yml --web.listen-address=127.0.0.1:{{ blackbox_exporter_port }}
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

