[Unit]
Description=AKHQ {{ akhq_version }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=akhq
Group=akhq
WorkingDirectory={{ akhq_data_dir }}
ExecStart={{ akhq_java_dir }}/bin/java -Dmicronaut.config.files={{ akhq_config_dir }}/application.yml -jar {{ akhq_install_dir }}/akhq.jar
Restart=on-failure
RestartSec=10s
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ akhq_data_dir }}
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0027

[Install]
WantedBy=multi-user.target

