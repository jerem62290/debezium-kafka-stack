---
micronaut:
  application:
    name: akhq
  security:
    enabled: true
    token:
      jwt:
        signatures:
          secret:
            generator:
              secret: "{{ hostvars['localhost'].akhq_jwt_secret }}"
  server:
    host: "{{ ui_bind_address }}"
    port: {{ akhq_port }}
    context-path: "{{ akhq_context_path }}"

akhq:
  connections:
    cdc-kafka:
      properties:
        bootstrap.servers: "{% for host in groups['kafka'] | sort %}{{ host }}:{{ kafka_client_port }}{% if not loop.last %},{% endif %}{% endfor %}"
        security.protocol: SSL
        ssl.keystore.type: PKCS12
        ssl.keystore.location: "{{ akhq_pki_dir }}/keystore.p12"
        ssl.keystore.password: "{{ hostvars['localhost'].kafka_keystore_password }}"
        ssl.key.password: "{{ hostvars['localhost'].kafka_keystore_password }}"
        ssl.truststore.type: PKCS12
        ssl.truststore.location: "{{ akhq_pki_dir }}/truststore.p12"
        ssl.truststore.password: "{{ hostvars['localhost'].kafka_truststore_password }}"
        ssl.endpoint.identification.algorithm: HTTPS
      connect:
{% for host in groups['kafka_connect'] | sort %}
        - name: "{{ host }}"
          url: "http://{{ host }}:{{ connect_rest_port }}"
{% endfor %}
  security:
    default-group: no-roles
    basic-auth:
      - username: "{{ akhq_admin_user }}"
        password: "{{ hostvars['localhost'].akhq_admin_password | hash('sha256') }}"
        passwordHash: SHA256
        groups:
          - admin
      - username: "{{ akhq_reader_user }}"
        password: "{{ hostvars['localhost'].akhq_reader_password | hash('sha256') }}"
        passwordHash: SHA256
        groups:
          - reader
