[Unit]
Description=Kafka Exporter {{ kafka_exporter_version }}
After=network-online.target
Wants=network-online.target

[Service]
User=kafka_exporter
Group=kafka_exporter
ExecStart={{ kafka_exporter_install_dir }}/kafka_exporter {% for host in groups['kafka'] | sort %}--kafka.server={{ host }}:{{ kafka_client_port }} {% endfor %}--tls.enabled --tls.ca-file={{ kafka_exporter_config_dir }}/pki/ca.crt --tls.cert-file={{ kafka_exporter_config_dir }}/pki/tls.crt --tls.key-file={{ kafka_exporter_config_dir }}/pki/tls.key --web.listen-address=127.0.0.1:{{ kafka_exporter_port }}
Restart=on-failure
RestartSec=10s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

