# Géré par Ansible — Kafka {{ kafka_version }}, KRaft sans ZooKeeper.
process.roles=broker,controller
node.id={{ kafka_node_id }}
controller.quorum.voters={% for host in groups['kafka'] | sort %}{{ loop.index }}@{{ host }}:{{ kafka_controller_port }}{% if not loop.last %},{% endif %}{% endfor %}

listeners=INTERNAL://{{ ansible_host }}:{{ kafka_client_port }},CONTROLLER://{{ ansible_host }}:{{ kafka_controller_port }}
advertised.listeners=INTERNAL://{{ inventory_hostname }}:{{ kafka_client_port }}
listener.security.protocol.map=INTERNAL:SSL,CONTROLLER:SSL
inter.broker.listener.name=INTERNAL
controller.listener.names=CONTROLLER
early.start.listeners=CONTROLLER

ssl.keystore.type=PKCS12
ssl.keystore.location={{ kafka_pki_dir }}/keystore.p12
ssl.keystore.password={{ hostvars['localhost'].kafka_keystore_password }}
ssl.key.password={{ hostvars['localhost'].kafka_keystore_password }}
ssl.truststore.type=PKCS12
ssl.truststore.location={{ kafka_pki_dir }}/truststore.p12
ssl.truststore.password={{ hostvars['localhost'].kafka_truststore_password }}
ssl.client.auth=required
listener.name.internal.ssl.client.auth=required
listener.name.controller.ssl.client.auth=required
ssl.protocol=TLSv1.3
ssl.enabled.protocols=TLSv1.2,TLSv1.3
ssl.endpoint.identification.algorithm=HTTPS
ssl.principal.mapping.rules=RULE:^.*CN=([^,]+).*$/$1/,DEFAULT

{% if kafka_acl_enabled | bool %}
authorizer.class.name=org.apache.kafka.metadata.authorizer.StandardAuthorizer
allow.everyone.if.no.acl.found=false
super.users={% for host in groups['kafka'] | sort %}User:{{ host }}{% if not loop.last %};{% endif %}{% endfor %}
{% endif %}

log.dirs={{ kafka_data_dir }}
metadata.log.dir={{ kafka_metadata_dir }}
num.network.threads={{ kafka_num_network_threads }}
num.io.threads={{ kafka_num_io_threads }}
num.partitions={{ kafka_num_partitions }}
default.replication.factor=3
min.insync.replicas=2
offsets.topic.replication.factor=3
transaction.state.log.replication.factor=3
transaction.state.log.min.isr=2
group.initial.rebalance.delay.ms=3000

auto.create.topics.enable=false
delete.topic.enable=true
unclean.leader.election.enable=false
controlled.shutdown.enable=true
log.retention.hours={{ kafka_log_retention_hours }}
log.segment.bytes={{ kafka_log_segment_bytes }}
log.retention.check.interval.ms=300000
message.max.bytes=10485880
replica.fetch.max.bytes=10485880
socket.request.max.bytes=104857600
